{
  "name": "@hos-ai/cli",
  "version": "0.1.0-alpha.1",
  "description": "The hos command: validate HOS 0.1 files, replay event streams, run the conformance scenarios and sign producer manifests.",
  "license": "Apache-2.0",
  "keywords": [
    "hos",
    "hospitality",
    "hotel",
    "pms",
    "conformance",
    "validator",
    "cli"
  ],
  "homepage": "https://hos-ai.vercel.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francoisnoel62/HOS-AI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/francoisnoel62/HOS-AI/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hos": "./dist/bin.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "generate": "node scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hos-ai/sdk": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

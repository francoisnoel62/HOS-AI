{
  "name": "@hos-ai/sdk",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Types, validation and processing rules for HOS Core 0.1 and HOS Events 0.1.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@hos-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@hos-ai/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./reference": {
      "@hos-ai/source": "./src/reference/index.ts",
      "types": "./dist/reference/index.d.ts",
      "default": "./dist/reference/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.ts",
    "signing-vectors": "node scripts/signing-vectors.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

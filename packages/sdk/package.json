{
  "name": "@hos-ai/sdk",
  "version": "0.1.0-alpha.1",
  "description": "Types, validation and processing rules for HOS Core 0.1 and HOS Events 0.1, with signed producer manifests.",
  "license": "Apache-2.0",
  "keywords": [
    "hos",
    "hospitality",
    "hotel",
    "pms",
    "housekeeping",
    "events",
    "json-schema",
    "jws"
  ],
  "homepage": "https://hos-ai.vercel.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francoisnoel62/HOS-AI.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/francoisnoel62/HOS-AI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@hos-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@hos-ai/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./reference": {
      "@hos-ai/source": "./src/reference/index.ts",
      "types": "./dist/reference/index.d.ts",
      "default": "./dist/reference/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "generate": "node scripts/generate.ts",
    "signing-vectors": "node scripts/signing-vectors.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

  "title": "Arrival readiness with the PMS side in Cloudbeds API format",
  "summary": "Synthetic Cloudbeds webhooks and the getReservation and getHousekeepingStatus responses an integration would fetch for them, replacing the PMS deliveries of the arrival-readiness conformance scenario. Run through the reference Cloudbeds adapter, they must reproduce the scenario's expected outcome. Unofficial: written from Cloudbeds's official SDK and published webhook samples, not affiliated with, reviewed or endorsed by Cloudbeds, and not yet run against a live Cloudbeds property. Two webhook payloads are reconstructed; each says so.",
  "sources": [
    {
      "label": "Cloudbeds official Python SDK, API v1.3",
      "url": "https://github.com/cloudbeds/cloudbeds-api-python/tree/release/v1",
      "revision": "abbc43bdcec310ebdd8e923908fd58431994d02a",
      "official": true,
      "covers": "Generated from Cloudbeds's OpenAPI description: getReservation, getHousekeepingStatus and getHotelDetails responses, reservation statuses, and webhook subscriptions by object and action."
    },
    {
      "label": "Pipedream Cloudbeds components",
      "url": "https://www.npmjs.com/package/@pipedream/cloudbeds",
      "revision": "0.1.0",
      "official": false,
      "covers": "Sample reservation/created and reservation/status_changed webhook payloads."
    },
    {
      "label": "n8n-nodes-cloudbeds (community)",
      "url": "https://www.npmjs.com/package/n8n-nodes-cloudbeds",
      "revision": "0.3.30",
      "official": false,
      "covers": "Webhook event names, including reservation/accommodation_changed and housekeeping/room_condition_changed."
    },
    {
      "label": "Cloudbeds developer documentation: webhooks",
      "url": "https://developers.cloudbeds.com/docs/webhooks-1",
      "official": true,
      "covers": "Read through search excerpts only: the site was not reachable from the build environment. It names roomID and old_roomID for accommodation changes."
    }
  ],

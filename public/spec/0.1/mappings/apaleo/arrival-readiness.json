{
  "mapping": "apaleo-api",
  "pms": "Apaleo",
  "hosschemaversion": "0.1",
  "status": "experimental",
  "title": "Arrival readiness with the PMS side in Apaleo API format",
  "summary": "Synthetic Apaleo webhook events and the Booking and Inventory API responses an integration would fetch for them, replacing the PMS deliveries of the arrival-readiness conformance scenario. Run through the reference Apaleo adapter, they must reproduce the scenario's expected outcome. Unofficial: written from Apaleo's published packages and documentation, not affiliated with, reviewed or endorsed by Apaleo, and not yet run against a live Apaleo account.",
  "sources": [
    {
      "label": "Apaleo official n8n node",
      "url": "https://www.npmjs.com/package/@apaleo/n8n-nodes-apaleo-official",
      "revision": "1.0.37",
      "official": true,
      "covers": "The webhook events an integration can subscribe to, such as reservation/unit-assigned, reservation/checked-in and unit/changed."
    },
    {
      "label": "Apaleo Booking API models",
      "url": "https://www.npmjs.com/package/@apaleo/angular-api-proxy-booking",
      "revision": "19.0.29",
      "official": true,
      "covers": "ReservationModel: status, arrival, departure, created, modified, unit, and check-in, check-out, cancellation and no-show times. The typings are generated from the evolving Booking API; the fields used here are those of v1."
    },
    {
      "label": "Apaleo Inventory API models",
      "url": "https://www.npmjs.com/package/@apaleo/angular-api-proxy-inventory",
      "revision": "19.0.29",
      "official": true,
      "covers": "UnitModel: occupancy, condition (Clean, CleanToBeInspected, Dirty) and maintenance (OutOfService, OutOfOrder, OutOfInventory)."
    },
    {
      "label": "Apaleo developer guide: webhook payload",
      "url": "https://apaleo.dev/guides/webhook/webhooks-payload.html",
      "official": true,
      "covers": "The webhook message: topic, type, id, accountId, propertyId, timestamp in milliseconds, clientId, subjectId and data.entityId. Read through a search excerpt: the site was not reachable from the build environment."
    }
  ],
  "scenario": "../../conformance/arrival-readiness/scenario.json",
  "adapter": {
    "source": "urn:hos:pms:demo",
    "tenant": "tenant_demo",
    "accountId": "HOSX",

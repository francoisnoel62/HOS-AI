{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hos:schema:0.1:event",
  "title": "HOS 0.1 event",
  "description": "Draft. A CloudEvents 1.0 event in structured JSON mode carrying one HOS Core fact or one projection situation. Data objects are closed so that personal or commercial data cannot travel unnoticed; CloudEvents extension attributes remain open.",
  "type": "object",
  "required": [
    "specversion",
    "type",
    "source",
    "id",
    "time",
    "datacontenttype",
    "hosschemaversion",
    "hosrecordedat",
    "hosbusinessdate",
    "hostimezone",
    "hospropertyid",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}$"
  },
  "properties": {
    "specversion": {
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "type": {
      "enum": [
        "reservation.updated",
        "stay.expected",
        "unit.status_changed",
        "task.completed",
        "stay.arrival_signaled",
        "arrival.room_readiness_at_risk",
        "arrival.room_readiness_resolved"
      ],
      "description": "HOS event type. Determines the shape of data."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "URI of the producer. Must equal the producer declared in its Event Producer manifest."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique within the source. A redelivered fact keeps the same id; source and id together identify a fact."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact occurred in the producing system. Ordering between facts uses this value, never the delivery order."
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the HOS entity the fact is about."
    },
    "datacontenttype": {
      "const": "application/json",
      "description": "HOS 0.1 data is always JSON."
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Optional reference to this schema."
    },
    "hosschemaversion": {
      "const": "0.1",
      "description": "HOS schema version the event conforms to."
    },
    "hosrecordedat": {
      "type": "string",
      "format": "date-time",
      "description": "When the producer recorded the fact. May be later than time, for example after an offline period."
    },
    "hosbusinessdate": {
      "type": "string",
      "format": "date",
      "description": "Property-local business date the fact belongs to, which can differ from the calendar date of time."
    },
    "hostimezone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(?:[/_+-][A-Za-z0-9]+)*$",
      "description": "IANA time zone of the property, used to present times and business dates locally."
    },
    "hospropertyid": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the property (tenant boundary)."
    },
    "hoscausationsource": {
      "type": "string",
      "format": "uri",
      "description": "Source of the event that caused this one, when known. Used together with hoscausationid."
    },
    "hoscausationid": {
      "type": "string",
      "minLength": 1,
      "description": "Id of the event that caused this one, when known."
    },
    "data": {
      "type": "object",
      "description": "The fact itself. Its shape is defined by type; data objects are closed."
    }
  },
  "dependentRequired": {
    "hoscausationid": ["hoscausationsource"],
    "hoscausationsource": ["hoscausationid"]
  },
  "allOf": [
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "reservation.updated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/reservation.updated"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "stay.expected"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/stay.expected"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "unit.status_changed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/unit.status_changed"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "task.completed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/task.completed"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "stay.arrival_signaled"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/stay.arrival_signaled"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "arrival.room_readiness_at_risk"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/arrival.room_readiness_at_risk"
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "arrival.room_readiness_resolved"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/arrival.room_readiness_resolved"
          }
        }
      }
    }
  ],
  "$defs": {
    "guestRef": {
      "type": "string",
      "minLength": 1,
      "description": "Pseudonymous guest reference. Never a name, email address, phone number or loyalty number."
    },
    "factRef": {
      "type": "object",
      "description": "A value together with the fact it comes from.",
      "required": ["value", "source", "event_id", "time"],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "event_id": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "conflictRef": {
      "type": "object",
      "description": "A non-authoritative value that disagrees with the authoritative value.",
      "required": ["dimension", "value", "source", "event_id", "time"],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "event_id": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "eventRef": {
      "type": "object",
      "required": ["source", "id"],
      "properties": {
        "source": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reservation.updated": {
      "title": "reservation.updated",
      "description": "The current state of a reservation, as held by the reservation system.",
      "x-hos-entity": "Reservation",
      "x-hos-authority": "pms",
      "type": "object",
      "required": ["reservation_id", "status", "arrival_date", "departure_date", "guest_ref"],
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["tentative", "confirmed", "cancelled", "no_show"]
        },
        "arrival_date": {
          "type": "string",
          "format": "date"
        },
        "departure_date": {
          "type": "string",
          "format": "date"
        },
        "guest_ref": {
          "$ref": "#/$defs/guestRef"
        }
      },
      "additionalProperties": false
    },
    "stay.expected": {
      "title": "stay.expected",
      "description": "A stay is expected to start, with its assigned unit and the planned check-in time.",
      "x-hos-entity": "Stay",
      "x-hos-authority": "pms",
      "type": "object",
      "required": [
        "stay_id",
        "reservation_id",
        "unit_id",
        "guest_ref",
        "arrival_date",
        "planned_checkin_at"
      ],
      "properties": {
        "stay_id": {
          "type": "string",
          "minLength": 1
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Assigned unit, or null while unassigned."
        },
        "guest_ref": {
          "$ref": "#/$defs/guestRef"
        },
        "arrival_date": {
          "type": "string",
          "format": "date"
        },
        "planned_checkin_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "unit.status_changed": {
      "title": "unit.status_changed",
      "description": "The status of one dimension of a unit changed. The authority field is informative: whether HOS treats the value as authoritative is decided by the producer manifests, never by this field.",
      "x-hos-entity": "Unit",
      "x-hos-authority": "housekeeping, pms or maintenance, per dimension",
      "type": "object",
      "required": ["unit_id", "dimension", "previous", "current", "authority"],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": ["housekeeping", "occupancy", "maintenance"]
        },
        "previous": {
          "type": ["string", "null"]
        },
        "current": {
          "type": "string"
        },
        "authority": {
          "enum": ["pms", "housekeeping", "maintenance", "messaging"],
          "description": "Role of the system that originated the value."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "housekeeping"
              }
            }
          },
          "then": {
            "properties": {
              "previous": {
                "enum": ["dirty", "cleaning", "clean", "inspected", null]
              },
              "current": {
                "enum": ["dirty", "cleaning", "clean", "inspected"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "occupancy"
              }
            }
          },
          "then": {
            "properties": {
              "previous": {
                "enum": ["vacant", "occupied", null]
              },
              "current": {
                "enum": ["vacant", "occupied"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "maintenance"
              }
            }
          },
          "then": {
            "properties": {
              "previous": {
                "enum": ["in_service", "out_of_order", null]
              },
              "current": {
                "enum": ["in_service", "out_of_order"]
              }
            }
          }
        }
      ]
    },
    "task.completed": {
      "title": "task.completed",
      "description": "An operational task on a unit was reported complete. Completing a task does not change the unit status by itself.",
      "x-hos-entity": "Task",
      "x-hos-authority": "housekeeping",
      "type": "object",
      "required": ["task_id", "unit_id", "task_type"],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "enum": ["cleaning", "inspection", "maintenance", "other"]
        },
        "completed_by_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudonymous staff reference."
        }
      },
      "additionalProperties": false
    },
    "stay.arrival_signaled": {
      "title": "stay.arrival_signaled",
      "description": "A guest message indicates when the guest expects to arrive. Only the extracted signal travels; the message content stays in the messaging system.",
      "x-hos-entity": "Stay (from a Message)",
      "x-hos-authority": "messaging",
      "type": "object",
      "required": ["stay_id", "expected_arrival_at", "channel", "message_ref"],
      "properties": {
        "stay_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_arrival_at": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "enum": ["sms", "email", "chat", "messaging_app", "phone", "other"]
        },
        "message_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque reference to the message in the messaging system."
        }
      },
      "additionalProperties": false
    },
    "arrival.room_readiness_at_risk": {
      "title": "arrival.room_readiness_at_risk",
      "description": "Projection situation. A guest is expected before the planned check-in time and the assigned unit is not ready according to its authoritative housekeeping status. Observation only: HOS 0.1 does not act on it.",
      "x-hos-entity": "Stay (projection)",
      "x-hos-authority": "projection",
      "type": "object",
      "required": [
        "stay_id",
        "reservation_id",
        "unit_id",
        "planned_checkin_at",
        "expected_arrival_at",
        "housekeeping",
        "conflicts",
        "latest_task",
        "evidence"
      ],
      "properties": {
        "stay_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "unit_id": {
          "type": ["string", "null"]
        },
        "planned_checkin_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_arrival_at": {
          "type": "string",
          "format": "date-time"
        },
        "housekeeping": {
          "oneOf": [
            {
              "$ref": "#/$defs/factRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authoritative housekeeping status of the unit, or null when no authoritative fact exists."
        },
        "conflicts": {
          "type": "array",
          "description": "Non-authoritative values that disagree with the authoritative value and are not older than it.",
          "items": {
            "$ref": "#/$defs/conflictRef"
          }
        },
        "latest_task": {
          "oneOf": [
            {
              "type": "object",
              "required": ["task_id", "task_type", "source", "event_id", "time"],
              "properties": {
                "task_id": {
                  "type": "string"
                },
                "task_type": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "format": "uri"
                },
                "event_id": {
                  "type": "string"
                },
                "time": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "description": "Facts the situation is derived from, sorted by occurrence time, then source, then id.",
          "items": {
            "$ref": "#/$defs/eventRef"
          }
        }
      },
      "additionalProperties": false
    },
    "arrival.room_readiness_resolved": {
      "title": "arrival.room_readiness_resolved",
      "description": "Projection situation. A previously raised room-readiness risk no longer applies.",
      "x-hos-entity": "Stay (projection)",
      "x-hos-authority": "projection",
      "type": "object",
      "required": [
        "stay_id",
        "reservation_id",
        "unit_id",
        "reason",
        "planned_checkin_at",
        "expected_arrival_at",
        "housekeeping",
        "evidence"
      ],
      "properties": {
        "stay_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "unit_id": {
          "type": ["string", "null"]
        },
        "reason": {
          "enum": ["unit_ready", "arrival_not_early", "reservation_inactive"]
        },
        "planned_checkin_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_arrival_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "housekeeping": {
          "oneOf": [
            {
              "$ref": "#/$defs/factRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventRef"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

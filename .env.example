# Local development only. Do not commit a populated .env.local.
DATABASE_URL=postgres://hos:hos@localhost:5432/hos_ai
FORM_ORIGIN=http://localhost:3000
FORM_RATE_LIMIT=5
FORM_RATE_LIMIT_WINDOW_SECONDS=3600
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FORM_ENCRYPTION_KEY=
# Use a distinct locally generated value before accepting submissions.
RATE_LIMIT_SALT=
HOS_INBOX_EMAIL=local-hos-inbox@localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/francoisnoel62/HOS-AI
# Required only for local Docker form testing. Never enable this in a public environment.
LOCAL_FORMS_MODE=true

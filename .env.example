# Local development only. Do not commit a populated .env.local.
DATABASE_URL=postgres://hos:hos@localhost:5432/hos_ai
FORM_ORIGIN=http://localhost:3000
FORM_RATE_LIMIT=5
FORM_RATE_LIMIT_WINDOW_SECONDS=3600
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FORM_ENCRYPTION_KEY=
# Use a distinct locally generated value before accepting submissions.
RATE_LIMIT_SALT=
HOS_INBOX_EMAIL=local-hos-inbox@localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/francoisnoel62/HOS-AI
# Authorises the daily retention purge (/api/cron/purge). Vercel Cron sends it as a bearer token.
CRON_SECRET=
# Required only for local Docker form testing. Never enable this in a public environment.
LOCAL_FORMS_MODE=true
# The PMS live checks and the pilot producer (npm run mews:live, apaleo:live, producer:poll), read-only.
# Mews publishes demo tokens in its Connector API documentation; an Apaleo app needs read scopes only.
# MEWS_CLIENT_TOKEN=
# MEWS_ACCESS_TOKEN=
# MEWS_PLATFORM_ADDRESS=https://api.mews-demo.com
# APALEO_CLIENT_ID=
# APALEO_CLIENT_SECRET=
# The database of the producer tests, apart from the forms database (README, Development checks).
# HOS_TEST_DATABASE_URL=postgres://hos:hos@localhost:5432/hos_ai_test
